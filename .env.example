# ─────────────────────────────────────────────────────────────────────────────
# Mockwave — Environment Variables
# Copy to .env and adjust values before starting.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Mockwave
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
APP_PORT=8080
INERTIA_USE_SCRIPT_ELEMENT_FOR_INITIAL_PAGE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_PORT_FORWARD=5432        # host-side port when using docker compose
DB_DATABASE=mockwave
DB_USERNAME=mockwave
DB_PASSWORD=secret

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PORT_FORWARD=6379

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=mockwave

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Mail (optional, for notifications) ───────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@mockwave.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Gateway settings ─────────────────────────────────────────────────────────
# Timeout in seconds for proxy requests to real services
GATEWAY_TIMEOUT_SECONDS=30

# Log request/response bodies (can be disabled for performance)
GATEWAY_LOG_REQUEST_BODY=true
GATEWAY_LOG_RESPONSE_BODY=true

# Maximum body size to store in request_logs (bytes). 0 = unlimited.
GATEWAY_MAX_LOG_BODY_SIZE=65536

# ── Admin panel auth ──────────────────────────────────────────────────────────
# Public authentication features
AUTH_REGISTRATION_ENABLED=false
AUTH_PASSWORD_RESET_ENABLED=false

# Default seeded admin credentials (change before production!)
ADMIN_EMAIL=admin@mockwave.local
ADMIN_PASSWORD=password
